# Credenciais e ajustes de ambiente do ControlJob.
#
# Este arquivo NÃO deve ir para o git. O .gitignore já cobre .env.
# Copie o .env.example para .env e preencha com os valores reais.

# --- E-mail (SMTP do Gmail) ---
# Use uma senha de app do Google, não a senha da sua conta.
# https://myaccount.google.com/apppasswords
MAIL_SMTP_HOST=smtp.gmail.com
MAIL_SMTP_PORT=587
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true

MAIL_USERNAME=seu-email@gmail.com
MAIL_APP_PASSWORD="cole-aqui-a-senha-de-app"

# --- Fechamento mensal ---
# Para enviar para mais de uma pessoa, separe os endereços por vírgula.
MAIL_DESTINATARIO=destinatario@example.com
MAIL_ASSUNTO=Relatório Mensal de Pagamentos

# --- Aplicação ---
CONTROLJOB_SALARIO_FIXO=1500.00
CONTROLJOB_ADMIN_USUARIO=admin
